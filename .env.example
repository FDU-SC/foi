# 配合 docker compose 时复制成 .env，配合 pnpm dev 时复制成 .env.local。
# 占位密钥仅供本机试用，对外的部署会被启动检查拦下。

# ---- 必填 ----

# 会话签名。用它伪造登录态的人可以变成任何账号，包括管理员。
#   openssl rand -base64 32
AUTH_SECRET=dev-only-not-a-real-secret-change-in-production

# 平台的对外地址。评测机据此回连，验证邮件里的链接也用它。
FOI_PUBLIC_URL=http://localhost:3000

# 评测机的入场凭证。拿到它就能领走队列里的提交、读到所有人的代码、写回任意判定。
#   openssl rand -hex 32
FOI_BACKEND_SECRET=dev-only-not-a-real-secret-change-in-production

# ---- 数据库 ----

# docker compose 会用这三个值起 PostgreSQL。连外部数据库就直接给 DATABASE_URL。
POSTGRES_USER=foi
POSTGRES_PASSWORD=foi_dev_password
POSTGRES_DB=foi

# DATABASE_URL=postgres://foi:foi_dev_password@localhost:5432/foi

# ---- 邮件 ----

# console 把邮件打到服务端日志，注册验证链接从日志里抄。想真的发信就填 smtp 与下面
# 那组 FOI_SMTP_*。生产环境不配 SMTP 会拒绝启动。
FOI_MAIL_DELIVERY=console

# FOI_SMTP_HOST=smtp.example.com
# FOI_SMTP_PORT=587
# FOI_SMTP_USER=
# FOI_SMTP_PASSWORD=
# FOI_SMTP_SECURE=false
# FOI_MAIL_FROM="FOI <noreply@example.com>"

# ---- 可选 ----

# dev | prod（默认 dev）。表达的是这套部署里有没有真实数据，不是它在发布流程里的
# 位置——预发布环境装着真账号和未公开的题，也填 prod。
# FOI_ENV=dev

# 宿主机上映射的端口，默认 3000。
# FOI_PORT=3000

# 反向代理的层数，直接暴露端口时填 0。取错会让限流按错误的来源计数。
# FOI_TRUSTED_PROXY_HOPS=1

# 关掉启动时的自动迁移，改为自己执行 pnpm db:migrate。
# FOI_AUTO_MIGRATE=false

# git commit sha，由 CI 注入，用于在页面上标出运行的是哪一版。
# FOI_RELEASE_SHA=

# ---- 每个评测队列一把密钥（可选） ----

# 不设则回落到上面的 FOI_BACKEND_SECRET。几个队列共用一把，任何一台评测机被攻破，
# 其余队列的提交与判定一起丢，启动检查会就此告警。
# FOI_BACKEND_TRADITIONAL_SECRET=
# FOI_BACKEND_INTERACTIVE_SECRET=

# 需要平台主动发起交互动作的后端（例如为选手拉起靶机）还要一个地址。
# 只做评测的后端不需要——评测机自己来领活。
# FOI_BACKEND_TRADITIONAL_URL=http://judge:8080
