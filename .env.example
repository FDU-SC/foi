# ---- Database ----

POSTGRES_USER=foi
POSTGRES_PASSWORD=foi_dev_password
POSTGRES_DB=foi

# ---- Required ----

AUTH_SECRET=dev-only-not-a-real-secret-change-in-production
FOI_PUBLIC_URL=http://localhost:3000
FOI_BACKEND_SECRET=dev-only-not-a-real-secret-change-in-production

# ---- Optional ----

# FOI_ENV=dev                      # dev | staging | prod (default: dev)
# FOI_PORT=8080                    # host port mapping (default: 8080)
# FOI_RELEASE_SHA=                 # git commit sha, set by CI
# FOI_TRUSTED_PROXY_HOPS=1         # reverse proxy layers, 0 = direct exposure
# FOI_AUTO_MIGRATE=false            # skip auto-migration on startup

# ---- Mail ----

FOI_MAIL_DELIVERY=console           # console | smtp (default: smtp)
# FOI_SMTP_HOST=smtp.example.com
# FOI_SMTP_PORT=587
# FOI_SMTP_USER=
# FOI_SMTP_PASSWORD=
# FOI_SMTP_SECURE=false
# FOI_MAIL_FROM="FOI <noreply@example.com>"

# ---- Per-backend overrides (optional in dev/staging) ----

# FOI_BACKEND_TRADITIONAL_URL=http://judge:8080
# FOI_BACKEND_TRADITIONAL_SECRET=per-backend-secret
