# Postgres. LISTEN/NOTIFY needs a direct, non-pooled connection, so avoid
# pointing this at PgBouncer in transaction mode.
DATABASE_URL=postgres://foi:foi_dev_password@localhost:5433/foi

# Migrations are applied at boot by instrumentation.ts, before anything touches
# the schema; drizzle records what it has already run, so this is a no-op once
# the database is up to date. Set to exactly `false` to hold them back — the
# only caller that does is CI, which wants the boot path exercised without
# migrating a database a previous step already migrated. Any other value,
# including an empty one, still migrates.
#FOI_AUTO_MIGRATE=false

# Password `pnpm db:seed` gives the four demo accounts (admin / alice / bob /
# carol), defaulting to foi-dev-2026. Seeding is a development convenience and
# has no business running against a deployment, so this belongs here and only
# here.
#FOI_SEED_PASSWORD=foi-dev-2026

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Public origin of this OJ. Evaluation is pulled, so this is the address the
# runners connect *to* — it must be reachable from wherever they run, and it is
# the only thing they need to know about the platform.
FOI_PUBLIC_URL=http://localhost:3000

# The commit this build came from, recorded on every submission so that "which
# code judged this" is answerable afterwards. CI passes it to `docker build` as
# an arg, so it is baked into the image rather than set in a `.env` — listed
# here because the code reads it, not because you should fill it in. Empty for
# `pnpm dev` and for hand-built images, which is honest: those did not come
# from a commit.
#FOI_RELEASE_SHA=

# How many reverse proxies sit in front of this process. Rate limits identify a
# caller by counting that many entries back from the end of `x-forwarded-for`,
# because everything to the left of the last proxy's entry was written by the
# caller.
#
# 0 says nothing trusted is in front, and it does more than it sounds like:
# with no proxy to believe, both headers could only have come from the peer, so
# there is no caller to identify and **every source-keyed bound stands aside**
# — the global one in proxy.ts, the flood gate in front of /api, login's
# per-source counter, and the hourly caps on registration and password
# recovery. That is deliberate; counting everybody in one bucket would turn a
# flood cap into an outage the moment two people used the deployment at once.
# What still holds is everything keyed on an account or a mailbox: the
# per-handle login counter, and the durable per-recipient cooldowns that will
# not mail the same address twice in a minute.
#
# 1 is the value for a deployment behind one reverse proxy, and it is also what
# an unset variable means. It is written here rather than 0 because `pnpm dev`
# sends no `x-forwarded-for` at all, so locally the two behave the same — and
# copying this file to something that *is* proxied should not silently take the
# source layer with it.
FOI_TRUSTED_PROXY_HOPS=1

# Fallback signing key, used by any backend without one of its own. This is
# what a runner authenticates with when it comes to claim work, and what the
# kernel signs interactive actions with. Generate with: openssl rand -hex 32
FOI_BACKEND_SECRET=

# Per-backend signing keys, which override the shared one above.
#
# Optional here and mandatory in a deployment — a production boot is refused
# when two backends that carry traffic are left sharing the fallback. The key
# points inward now: holding it means being able to claim from that backend's
# queue, which is to say read every submission in it and write whatever verdict
# you like. One key across two backends makes compromising the softer of them
# good against both. Names match the URL variables below.
#FOI_BACKEND_TRADITIONAL_SECRET=
#FOI_BACKEND_LEAKY_BUCKET_SECRET=

# SMTP. Registration mails a code and password recovery mails a link, so
# without a host here neither can complete — which is why leaving FOI_SMTP_HOST
# empty prints the whole message, code or link included, to the server console
# instead. That is the intended local setup; `docker compose up -d` also starts
# Mailpit on http://localhost:8025 if you would rather read them in a browser.
#
# Outside production only, and it warns on the way past. The same empty value
# refuses a production boot, for the reason the backend addresses below give:
# the console sink is a decision, and a deployment that means it declares
# `mailDelivery: "console"` in content/enrollment/ rather than leaving this out.
FOI_SMTP_HOST=
FOI_SMTP_PORT=587
FOI_SMTP_USER=
FOI_SMTP_PASSWORD=
# Implicit TLS. Only ever true on port 465.
FOI_SMTP_SECURE=false
# Sends without encryption when the relay cannot do STARTTLS. Only ever for the
# local Mailpit, which offers none — over a real network this hands the
# verification code, the reset link and FOI_SMTP_PASSWORD to anyone on the path.
FOI_SMTP_ALLOW_INSECURE=false
FOI_MAIL_FROM=FOI <foi@localhost>

# Problem backend addresses. Names correspond to entries in content/backends.ts.
#
# Needed by far fewer backends than they used to be, and the reason is the
# direction: nothing is dispatched any more, so a backend that only judges needs
# no address at all — its runner comes to FOI_PUBLIC_URL instead. What still
# goes outward is POST /action/<name>, the spawn/poll/destroy a player sets off
# synchronously, and only a backend some problem declares an `actions` entry on
# needs to be reachable for that. Today that is leaky-bucket alone.
#
# All optional here: outside production an entry with no address falls back to
# `pnpm backend:mock` on :4100, which is what lets a fresh checkout run the
# container problem without configuring anything. In production a backend with
# actions and no address refuses the boot.
#
# Every entry is listed even though all are commented out, because this file is
# where the names get read off. Listing only some of them left the others
# unnamed anywhere a reader would look, which is how three deployments came to
# be missing four addresses each.
#
# The list is shorter than it was: flag-checker, output-only and roulette were
# retired as services and are now inline judges in
# content/problems/_shared/judge/. Judging them needed nothing the kernel does
# not already hold, so they needed no address, no key and no deployment.
#FOI_BACKEND_TRADITIONAL_URL=http://localhost:4100
#FOI_BACKEND_INTERACTIVE_URL=http://localhost:4103
#FOI_BACKEND_PERFORMANCE_URL=http://localhost:4104
#FOI_BACKEND_LEAKY_BUCKET_URL=http://localhost:4105
