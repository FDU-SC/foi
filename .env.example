# Postgres. LISTEN/NOTIFY needs a direct, non-pooled connection, so avoid
# pointing this at PgBouncer in transaction mode.
DATABASE_URL=postgres://foi:foi_dev_password@localhost:5433/foi

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Public origin of this OJ. Judges call back to it, so it must be reachable
# from wherever the judges run.
FOI_PUBLIC_URL=http://localhost:3000

# Shared secret for signing judge requests and verifying judge callbacks.
# Generate with: openssl rand -hex 32
FOI_JUDGE_SECRET=

# Seconds a submission may sit unfinished before the reconciler polls the
# judge directly instead of waiting for a callback.
FOI_JUDGE_RECONCILE_AFTER=30

# Judge endpoints. Keys correspond to entries in judges.config.ts.
FOI_JUDGE_TRADITIONAL_URL=http://localhost:4100
FOI_JUDGE_FLAG_CHECKER_URL=http://localhost:4101
