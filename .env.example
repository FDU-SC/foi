# Postgres. LISTEN/NOTIFY needs a direct, non-pooled connection, so avoid
# pointing this at PgBouncer in transaction mode.
DATABASE_URL=postgres://foi:foi_dev_password@localhost:5433/foi

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Public origin of this OJ. Judges call back to it, so it must be reachable
# from wherever the judges run.
FOI_PUBLIC_URL=http://localhost:3000

# Shared secret for signing judge requests and verifying judge callbacks.
# Generate with: openssl rand -hex 32
FOI_JUDGE_SECRET=

# Seconds a submission may sit unfinished before the reconciler polls the
# judge directly instead of waiting for a callback.
FOI_JUDGE_RECONCILE_AFTER=30

# SMTP. Registration and password recovery both work by emailing a link, so
# without a host here neither can complete — which is why leaving FOI_SMTP_HOST
# empty prints the whole message, link included, to the server console instead.
# That is the intended local setup; `docker compose up -d` also starts Mailpit
# on http://localhost:8025 if you would rather read them in a browser.
FOI_SMTP_HOST=
FOI_SMTP_PORT=587
FOI_SMTP_USER=
FOI_SMTP_PASSWORD=
# Implicit TLS. Only ever true on port 465; other ports still upgrade via
# STARTTLS when the server offers it.
FOI_SMTP_SECURE=false
FOI_MAIL_FROM=FOI <foi@localhost>

# Judge endpoints. Keys correspond to entries in judges.config.ts.
FOI_JUDGE_TRADITIONAL_URL=http://localhost:4100
FOI_JUDGE_FLAG_CHECKER_URL=http://localhost:4101
