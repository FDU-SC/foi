# 环境变量模板。

# **必填** dev/staging/prod
FOI_ENV=dev

FOI_IMAGE=ghcr.io/<owner>/<repo>:dev

POSTGRES_USER=foi
POSTGRES_PASSWORD=foi_dev_password
POSTGRES_DB=foi

AUTH_SECRET=
AUTH_TRUST_HOST=true

# 本站对外的地址
FOI_PUBLIC_URL=http://localhost:3000

# 前面有几层代理？
FOI_TRUSTED_PROXY_HOPS=1

# runner 领任务用的密钥
FOI_BACKEND_SECRET=

# 邮件。不填 HOST 回落到 console 打印
FOI_SMTP_HOST=
FOI_SMTP_PORT=587
FOI_SMTP_USER=
FOI_SMTP_PASSWORD=
# 隐式 TLS，只有 465 端口上才是 true。其它端口用 STARTTLS 升级，升不上去就拒发，
# 所以一个不提供加密的中继会在这里停工，而不是悄悄把重置链接明文发出去。
FOI_SMTP_SECURE=false
# 中继连 STARTTLS 都不提供时明文发送。**只给本地 Mailpit 用**，它不提供加密。
# 走真实网络时这等于把验证码、重置链接和 FOI_SMTP_PASSWORD 交给路径上的任何人。
FOI_SMTP_ALLOW_INSECURE=false
FOI_MAIL_FROM=FOI <foi@localhost>