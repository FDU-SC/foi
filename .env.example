# 环境变量模板。

# **必填** dev/staging/prod
FOI_ENV=dev

FOI_IMAGE=ghcr.io/<owner>/<repo>:dev

POSTGRES_USER=foi
POSTGRES_PASSWORD=foi_dev_password
POSTGRES_DB=foi

AUTH_SECRET=
AUTH_TRUST_HOST=true

# 本站对外的地址
FOI_PUBLIC_URL=http://localhost:3000

# 前面有几层代理？
FOI_TRUSTED_PROXY_HOPS=1

# runner 领任务用的密钥
FOI_BACKEND_SECRET=

# 邮件。dev/staging 不填 HOST 就回落到 console 打印；prod 上声明了 smtp 却不填会拒绝启动
FOI_SMTP_HOST=
FOI_SMTP_PORT=587
FOI_SMTP_USER=
FOI_SMTP_PASSWORD=
# 隐式 TLS，只有 465 端口上才是 true。其它端口一律用 STARTTLS 升级，升不上去就拒发，
# 所以一个不提供加密的中继会在这里停工，而不是悄悄把重置链接明文发出去。没有豁免开关。
FOI_SMTP_SECURE=false
FOI_MAIL_FROM=FOI <foi@localhost>