# 环境变量模板。和 docker-compose.example.yml 成对：模板进仓库，实例不进。
#
#   cp .env.example .env
#   cp docker-compose.example.yml docker-compose.yml
#
# 下面填的是**本机开发**能直接跑起来的值：补一个 AUTH_SECRET，
# `docker compose up -d` 起 Postgres 与 Mailpit，然后 `pnpm dev`。
#
# 三个部署环境用的是同一份编排、同一份本模板，差异全部是取值，集中列在文件末尾
# 的「四种用法的差异」一节。
#
# 服务器上那份 .env 与编排不同：编排每次部署由工作流从模板原样覆盖，而 .env 由人
# 设一次、部署从不改写，密钥因此一直有效。

# ── 这套部署是哪一层 ────────────────────────────────────────────────────────
# local | dev | staging | prod。部署环境**必填**。
#
# 哪个目录属于哪一层，从前只有 GitHub Environment 里那个 DEPLOY_PATH secret
# 知道。那里打错一个字，一次测试站发布就会安静地、成功地上到正式站——没有任何
# 一步会报错，因为从每一步自己的角度看都正常。所以让每套部署自己说出自己是谁：
# 运维脚本 拿分支算出来的层和这一行对照，不一致就一步都不做。
#
# 是声明而不是推断，理由和 policy.mailDelivery 是同一个：从目录名或端口号猜，
# 是又一件在有人改名之前一直都对的事。
#
# 快照那一路也读它——目标只要声明自己是 prod，恢复脚本直接拒绝执行。
FOI_ENV=local

# ── Compose ─────────────────────────────────────────────────────────────────
# 起哪些服务。local = postgres + mailpit（应用由 pnpm dev 在容器外跑）；
# deploy = postgres + app + backup。
COMPOSE_PROFILES=local

# 同一台主机上跑几套时，用它隔离容器、网络与卷。
COMPOSE_PROJECT_NAME=foi-local

# 部署时由工作流按 digest 覆盖。这里的值是给主机上手工敲 `docker compose` 用的，
# 所以让它指向本环境的移动 tag。本机开发用不到它，但 compose 会解析整个文件，
# 所以不能留空。
FOI_IMAGE=ghcr.io/<owner>/<repo>:dev

# 应用容器名。Caddy 按它反向代理，同一台主机上必须各不相同。
FOI_APP_NAME=foi-app

# 应用端口的**完整发布规格**，直接交给 compose 的 ports。
#
# 写全而不是只写端口号，是因为绑哪个地址三层各不相同，而编排不该因此分叉。
# docker 发布端口绕过 ufw，所以不要写成裸端口让它绑 0.0.0.0。
FOI_PUBLISH=127.0.0.1:3000:3000

# Postgres 的发布规格。一律绑回环：本机开发要它是因为应用在容器外跑，部署环境
# 用得上是因为 psql 和快照都从宿主机发起。三套栈同机时端口要各不相同。
POSTGRES_PUBLISH=127.0.0.1:5433:5432

# Caddy 建的共享网络，必须已经存在。
CADDY_NETWORK=caddy-network

# 数据卷。正式站设成 true，compose 于是拒绝创建它、也就拒绝删除它——`down -v`
# 报一句 external 然后跳过；那台机器上要先手工 `docker volume create`。
# 另两层和本机开发留 false，卷照常由 compose 建。
FOI_PGDATA_EXTERNAL=false
# 卷名每个环境都要显式给，同机的几套栈必须各不相同。compose 不给 external 卷加
# 项目名前缀，所以正式站留空会让几套栈共用一个库；而留空在任何环境下都跑不起来
# （`config` 看着正常，`up` 报 invalid volume name or ID: value is empty）。
FOI_PGDATA_VOLUME=foi-local-pgdata

# ── 数据库 ──────────────────────────────────────────────────────────────────
# 只有本机开发读这一行：应用跑在容器外，要自己找到 Postgres。容器里的应用不读
# 它，DATABASE_URL 由 docker-compose.yml 按下面三个变量拼出来。
#
# LISTEN/NOTIFY 需要直连、非池化的连接，不要指向 transaction 模式的 PgBouncer。
DATABASE_URL=postgres://foi:foi_dev_password@localhost:5433/foi

POSTGRES_USER=foi
POSTGRES_PASSWORD=foi_dev_password
POSTGRES_DB=foi

# 容器起来时自动跑迁移，在任何东西碰到 schema 之前。drizzle 自己记着哪些已经跑
# 过，所以库是最新的时候这一步什么也不做；跑失败会直接中止启动——宁可这次部署红
# 掉，也不要顶着旧 schema 半可用地对外服务。
# 只有恰好填 `false` 才会跳过（CI 用得上），其它任何值——包括空——都照跑。
#FOI_AUTO_MIGRATE=false

# ── 应用 ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# 本站对外的地址。评测是拉取式的，所以这是**评测机连过来**的那个地址，也是它们
# 需要知道的关于平台的全部——必须从每一台跑 runner 的机器上真的可达。
FOI_PUBLIC_URL=http://localhost:3000

# 这一版是从哪个 commit 构建的，会记在每一条提交上，事后才答得出「这一条是哪份
# 代码判的」。**不要在这里填**：部署工作流把它作为 build arg 传给 docker build，
# 值随镜像一起固化，写在 .env 里只会和镜像里的那个对不上。列在这里只是因为代码
# 会读它。`pnpm dev` 和手工构建的镜像里它是空的，那也诚实：它们不来自某个 commit。
#FOI_RELEASE_SHA=

# `pnpm db:seed` 给四个演示账号（admin / alice / bob / carol）用的统一密码。
# **部署环境不要 seed**，所以那几台机器上这一行永远不该被取消注释。
#FOI_SEED_PASSWORD=foi-dev-2026

# 前面有几层反向代理。限流靠这个数从 `x-forwarded-for` 末尾往回数来认人：最后
# 一层代理写下的那一项之前的内容，全是调用方自己填的，取错了就等于让对方自选
# 限流桶——同一台机器换个 header 就能把密码喷洒摊成几十台机器。
#
# 填 0 意味着**按来源的限流整层关掉**：没有可信代理，两个 header 就都只可能是
# 对端自己填的，认不出来源。整层让路而不是把所有人塞进同一个桶——共用一个桶不是
# 「弱一点的按来源限流」，是两个人同时用就互相锁死。让路的具体有 proxy.ts 的全局
# 闸、/api 之前的 flood 闸、登录的第二重计数，以及注册、发验证码、验验证码、找回
# 密码、重置密码这五个动作各自的每小时上限。
#
# 仍然拦得住的是按账号与按邮箱那一路，它们与代理层数无关也伪造不了：登录按 handle
# 计数照旧；同一个邮箱一分钟内不会收到第二封验证码或重置链接；六位验证码错够次数
# 就作废。也就是说针对某一个人的爆破仍然拦得住，量本身不再拦。
#
# 本机开发填 1：`pnpm dev` 根本不发 `x-forwarded-for`，所以 0 和 1 表现一样，而
# 把这份文件复制到一台**真的**有代理的机器上时，不该顺手把按来源那一层也带走。
# **正式站填 1（Caddy 那一层是真的），dev 与 staging 填 0。**
FOI_TRUSTED_PROXY_HOPS=1

# ── 题目后端 ────────────────────────────────────────────────────────────────
# 回落签名密钥，给下面任何没有自己密钥的后端用。这是评测机来领活时用来认证自己
# 的东西，也是内核给交互动作签名用的。Generate with: openssl rand -hex 32
FOI_BACKEND_SECRET=

# 每台后端一把签名密钥，与那台后端的 runner 配的那把一致。
# **生产环境下两个有流量的后端共用上面那把回落密钥会拒绝启动。**
#
# 从前只是警告，改成拒绝是因为这把钥匙换了方向。它从前是本平台**向**后端证明
# 自己，从我们控制的服务器发出；现在是 runner **向我们**证明自己，从随便谁跑
# runner 的那台机器发出。拿到一把就等于拿到那个队列的全部：每个人的源码、随手
# 改判的自由、以及把一条提交的次数烧光让它看起来像被干扰过。两台共用一把，攻破
# 其中更软的那台就等于两台一起丢。
#
# 确实由同一套 runner 服务的几个条目，把它们填成相同的值即可——那是显式的，而在
# 大多数后端已经没有地址可供归组之后，这是启动检查推断不出来的东西。
#
# 这里不列名字，这正是重点：有哪些后端是 `content/backends.ts` 的决定。这份文件
# 从前抄了一份名册，于是换掉 content 就留下一份描述着不存在的部署的模板，而新增
# 一台后端要记得改四个文件。运维脚本 会按声明的 id 替你写好；
# `pnpm exec tsx scripts/list-backends.ts` 打印它们，content/env.example 是这套
# 部署自己的带注释副本。
#
# <ID> 是 id 大写、连字符换下划线：`leaky-bucket` → `LEAKY_BUCKET`。
#
#   FOI_BACKEND_<ID>_SECRET=
#
# 地址反过来大多不再需要。评测是拉取式的——runner 自己来 FOI_PUBLIC_URL 领活——
# 所以纯评测的后端根本不需要地址，也不必从这里可达。拉不了的是 spawn/poll/destroy：
# 选手点一下、平台同步发起并等答案，那台机器就得能拨通。**只有有题目在它上面声明
# 了 `actions` 的后端才需要地址**，声明了动作却没有地址，生产环境拒绝启动。
#
# 从应用容器里看出去解析：跑在宿主机上的后端用 host.docker.internal，共享
# caddy-network 的用容器名。localhost 也接受——后端确实可能和平台同机——但 /admin
# 会标出来，因为把开发地址抄进生产正是这件事出错的方式。
#
#   FOI_BACKEND_<ID>_URL=

# 非生产环境下，没配地址的后端回落到哪里。留空就是没有回落。
# `pnpm backend:mock` 在 :4100 上起 content/ 里那个参考 runner。
FOI_DEV_BACKEND_URL=http://localhost:4100

# ── 邮件 ────────────────────────────────────────────────────────────────────
# 注册要收验证码，找回密码要收链接，所以没有中继这两件事都完不成。
#
# **本机开发不需要真的 SMTP**：留空 FOI_SMTP_HOST，整封信连同验证码或链接会直接
# 打到控制台。想要网页收件箱就填 localhost:1025，然后开 http://localhost:8025
# 读 compose 起的 Mailpit。
#
# **部署环境留空会拒绝启动**，而不是启动之后把每一个验证码和每一条重置链接打进
# 容器日志。两者之中得到哪一个是一条声明而不是一次推断：`content/enrollment/` 里
# 的 `policy.mailDelivery` 默认是 "smtp"，真的不发信的部署在那里写
# `mailDelivery: "console"`，而不是这里少填一个变量。
#
# 用一个被授权以 FOI_MAIL_FROM 的域名发信的中继。对不上则谁的 SPF 都过不了，
# 验证邮件进垃圾箱——那看起来和信根本没发出去一模一样。
FOI_SMTP_HOST=
FOI_SMTP_PORT=587
FOI_SMTP_USER=
FOI_SMTP_PASSWORD=
# 隐式 TLS，只有 465 端口上才是 true。其它端口用 STARTTLS 升级，升不上去就拒发，
# 所以一个不提供加密的中继会在这里停工，而不是悄悄把重置链接明文发出去。
FOI_SMTP_SECURE=false
# 中继连 STARTTLS 都不提供时明文发送。**只给本地 Mailpit 用**，它不提供加密。
# 走真实网络时这等于把验证码、重置链接和 FOI_SMTP_PASSWORD 交给路径上的任何人。
FOI_SMTP_ALLOW_INSECURE=false
FOI_MAIL_FROM=FOI <foi@localhost>

# 回落邮件文案按哪个时区读时钟，IANA 时区名。只有 lib/mail/registry.ts 里那几个
# 内置模板用它，而且只用来说验证码或链接什么时候过期。不设则跟随进程所在时区。
#FOI_TIMEZONE=Asia/Shanghai

# ── 备份 ────────────────────────────────────────────────────────────────────
# 提交记录是全站唯一无法从仓库重建的东西：题目、比赛、分流规则和角色都随镜像
# 上线，回滚一个版本就能全部拿回来，唯独一行提交拿不回来。评测队列也在这个库
# 里，所以丢库不只是丢历史，还会把当时正在排队和评测的那些提交一起丢掉。
#
# backup 服务按下面的间隔把数据库 dump 到宿主机目录。**这仍然只是同一块磁盘上
# 的一份副本**——真正的灾备要靠把这个目录同步到别处（rclone、restic、或者一条
# rsync 到另一台机器的 cron）。
FOI_BACKUP_DIR=./backups
FOI_BACKUP_INTERVAL_SECONDS=86400
FOI_BACKUP_KEEP=14

# ════════════════════════════════════════════════════════════════════════════
# 四种用法的差异
# ════════════════════════════════════════════════════════════════════════════
#
# 编排是同一份，下面这些取值不同。其余（密钥、后端配置）每套各自独立。
#
# 本机开发 —— 就是上面这些值，补一个 AUTH_SECRET 即可。
#
# 开发站（分支 main，<deploy-path>/.env）：
#
#   FOI_ENV=dev
#   COMPOSE_PROFILES=deploy
#   COMPOSE_PROJECT_NAME=foi-dev
#   FOI_IMAGE=<registry>/<owner>/<repo>:dev
#   FOI_APP_NAME=foi-dev-app
#   FOI_PGDATA_VOLUME=foi-dev_pgdata
#   FOI_PUBLISH=8532:3000               # 这台机器只在 tailnet 上，绑 0.0.0.0
#   POSTGRES_PUBLISH=127.0.0.1:5433:5432
#   DATABASE_URL=                       # 容器里不读，留空即可
#   FOI_PUBLIC_URL=http://<tailnet-host>:8532
#   FOI_TRUSTED_PROXY_HOPS=0
#
# 测试站（分支 staging，<deploy-path>/.env）：
#
#   FOI_ENV=staging
#   COMPOSE_PROFILES=deploy
#   COMPOSE_PROJECT_NAME=foi-staging
#   FOI_IMAGE=<registry>/<owner>/<repo>:staging
#   FOI_APP_NAME=foi-staging-app
#   FOI_PGDATA_VOLUME=foi-staging_pgdata
#   FOI_PUBLISH=8633:3000
#   POSTGRES_PUBLISH=127.0.0.1:5434:5432
#   FOI_PUBLIC_URL=http://<tailnet-host>:8633
#   FOI_TRUSTED_PROXY_HOPS=0
#
# 正式站（分支 prod，<deploy-path>/.env）：
#
#   FOI_ENV=prod
#   COMPOSE_PROFILES=deploy
#   COMPOSE_PROJECT_NAME=foi
#   FOI_IMAGE=<registry>/<owner>/<repo>:latest
#   FOI_APP_NAME=foi-app
#   FOI_PUBLISH=127.0.0.1:8080:3000     # 只绑回环，对外由 Caddy 转发
#   POSTGRES_PUBLISH=127.0.0.1:5435:5432
#   FOI_PUBLIC_URL=https://<正式站域名>
#   FOI_TRUSTED_PROXY_HOPS=1
#   FOI_PGDATA_EXTERNAL=true
#   FOI_PGDATA_VOLUME=foi_pgdata        # 先 docker volume create foi_pgdata
#
# 正式站的 Caddyfile 因此是 `reverse_proxy 127.0.0.1:8080`。也可以继续按容器名
# 走 caddy-network，两者都行——发布回环端口不比 `docker compose exec` 多暴露
# 任何东西，而它让三层的编排真的完全相同。
#
# 测试站还要在 GitHub 上给 `staging` 环境配一个变量（不是 secret）：
#
#   FOI_SNAPSHOT_FROM=<deploy-path>
#
# 配了它，每次测试站部署都会先把正式站的库整个拷过来，再让新镜像在那份 schema
# 上跑迁移——于是每次部署都是一次真实的迁移彩排。留空则不灌。单次跳过：手动触发
# 时勾 skip_snapshot，或在提交信息里写 [no-snapshot]。
