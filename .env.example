FOI_ENV=dev

POSTGRES_USER=foi
POSTGRES_PASSWORD=foi_dev_password
POSTGRES_DB=foi

# docker-compose builds DATABASE_URL from the variables above.
# Uncomment and adjust if running without docker-compose:
# DATABASE_URL=postgres://foi:foi_dev_password@localhost:5432/foi

AUTH_SECRET=dev-only-not-a-real-secret-change-in-production
AUTH_TRUST_HOST=true

FOI_PUBLIC_URL=http://localhost:3000

FOI_BACKEND_SECRET=dev-only-not-a-real-secret-change-in-production

FOI_MAIL_DELIVERY=console
