# Postgres. LISTEN/NOTIFY needs a direct, non-pooled connection, so avoid
# pointing this at PgBouncer in transaction mode.
DATABASE_URL=postgres://foi:foi_dev_password@localhost:5433/foi

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Public origin of this OJ. Problem backends call back to it, so it must be
# reachable from wherever they run.
FOI_PUBLIC_URL=http://localhost:3000

# How many reverse proxies sit in front of this process. Rate limits identify a
# caller by counting that many entries back from the end of `x-forwarded-for`,
# because everything to the left of the last proxy's entry was written by the
# caller. Set 0 when the app publishes its own port with nothing in front of
# it: every request then shares one bucket, which is weaker but not forgeable.
FOI_TRUSTED_PROXY_HOPS=0

# Fallback secret for signing backend requests and verifying judge callbacks,
# used by any backend without one of its own. Generate with: openssl rand -hex 32
FOI_BACKEND_SECRET=

# Per-backend signing keys, which override the shared one above. Give each
# backend that carries traffic its own: with a single key, compromising the
# softest backend yields a signature the others accept, including for reporting
# verdicts on their submissions. /admin says so when two or more end up sharing.
# Names match the URL variables below.
#FOI_BACKEND_TRADITIONAL_SECRET=
#FOI_BACKEND_FLAG_CHECKER_SECRET=

# Seconds a submission may sit unfinished before the reconciler polls the
# backend directly instead of waiting for a callback.
FOI_JUDGE_RECONCILE_AFTER=30

# SMTP. Registration mails a code and password recovery mails a link, so
# without a host here neither can complete — which is why leaving FOI_SMTP_HOST
# empty prints the whole message, code or link included, to the server console
# instead. That is the intended local setup; `docker compose up -d` also starts
# Mailpit on http://localhost:8025 if you would rather read them in a browser.
#
# Outside production only, and it warns on the way past. The same empty value
# refuses a production boot, for the reason the backend addresses below give:
# the console sink is a decision, and a deployment that means it declares
# `mailDelivery: "console"` in content/enrollment/ rather than leaving this out.
FOI_SMTP_HOST=
FOI_SMTP_PORT=587
FOI_SMTP_USER=
FOI_SMTP_PASSWORD=
# Implicit TLS. Only ever true on port 465.
FOI_SMTP_SECURE=false
# Sends without encryption when the relay cannot do STARTTLS. Only ever for the
# local Mailpit, which offers none — over a real network this hands the
# verification code, the reset link and FOI_SMTP_PASSWORD to anyone on the path.
FOI_SMTP_ALLOW_INSECURE=false
FOI_MAIL_FROM=FOI <foi@localhost>

# Problem backend addresses. Names correspond to entries in backends.config.ts.
#
# All optional here, and `pnpm backend:mock` needs none of them: outside
# production an entry with no address falls back to that mock on :4100, which
# is what lets a fresh checkout submit something before anything is configured.
# A deployment gets no such fallback — the app refuses to boot over a missing
# address rather than dispatching to whatever is listening on :4100 next to it,
# because a backend nothing can reach means every submission waits ten minutes
# and is then marked timed out, with nothing saying why. See
# .env.production.example, where these are mandatory.
#
# Set one to point a backend somewhere else: a real backend running locally, or
# a second mock (`MOCK_BACKEND_PORT=4101 pnpm backend:mock`).
#
# All six are listed even though every one is commented out, because this file
# is where the names get read off. Listing only some of them left the other
# three unnamed anywhere a reader would look, which is how three deployments
# came to be missing four addresses each.
#FOI_BACKEND_TRADITIONAL_URL=http://localhost:4100
#FOI_BACKEND_FLAG_CHECKER_URL=http://localhost:4101
#FOI_BACKEND_OUTPUT_ONLY_URL=http://localhost:4102
#FOI_BACKEND_INTERACTIVE_URL=http://localhost:4103
#FOI_BACKEND_PERFORMANCE_URL=http://localhost:4104
#FOI_BACKEND_LEAKY_BUCKET_URL=http://localhost:4105
